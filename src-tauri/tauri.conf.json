{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SRPH Link",
  "version": "0.4.0",
  "identifier": "com.jv.nexlink",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SRPH Link",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MDM4NTgyOTZCOTkyOUIKUldTYmtybVdnb1VEV2RKQWEvUUlMdEZrU1haYnlVdmwwNTFoRmlIZ09wb015QnV0NFQyV3FBUW4K",
      "endpoints": [
        "https://jvsk.go.th/api/v1/download/SRPH-Link-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
